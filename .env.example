# LateWiz multi-user configuration
# Copy to .env.local and fill in values.

# --- Required for multi-user ---
# SQLite file path for local/dev (default: ./data/latewiz.db). Created automatically on first run.
# SQLITE_PATH=./data/latewiz.db

# --- Required on Vercel (persistent DB) ---
# Local SQLite on Vercel is ephemeral (/tmp) — signup works once, then login fails.
# Create a free Turso DB: https://turso.tech  then set:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...

BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
VAULT_MASTER_KEY=generate-with-openssl-rand-hex-32

# Public app URL (OAuth callbacks + Better Auth + deep-research PDF links in posts)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LateWiz

# Optional: extra trusted origins (comma-separated). Localhost is always allowed.
# BETTER_AUTH_TRUSTED_ORIGINS=https://latewiz.com,https://www.latewiz.com
# BETTER_AUTH_ALLOWED_HOSTS=my-preview.vercel.app

# Password reset emails (Resend). Required for /forgot-password on production.
# RESEND_API_KEY=re_...
# EMAIL_FROM=LateWiz <noreply@yourdomain.com>

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Cron protection for /api/cron/campaigns
# CRON_SECRET=

# Solo local-dev only: allow server env keys as fallback when vault is empty
# ALLOW_ENV_KEY_FALLBACK=true
# LATE_API_KEY=sk_...
# OPENAI_API_KEY=sk-...
# FAL_KEY=

# Optional AI / search tuning
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_NATIVE_WEB_SEARCH=true
# OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium
# TAVILY_API_KEY=
# SERPER_API_KEY=
# ZERNIO_API_URL=https://zernio.com/api/v1
